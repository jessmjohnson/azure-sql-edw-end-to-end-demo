{
	"name": "Populate Bronze Ingestion Queue",
	"properties": {
		"activities": [
			{
				"name": "Register New Date Folders",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Bronze_Folder",
						"type": "DatasetReference",
						"parameters": {
							"param_folderPath": {
								"value": "@pipeline().parameters.bronzeDataFolder",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEach Date Folder",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Register New Date Folders",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": []
			}
		],
		"parameters": {
			"bronzeDataFolder": {
				"type": "string"
			}
		},
		"folder": {
			"name": "Utilities"
		},
		"annotations": []
	}
}